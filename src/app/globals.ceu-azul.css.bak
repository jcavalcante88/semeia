@import url("https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,500;0,600;1,6..72,400&family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Karla:wght@400;500;600;700&display=swap");

:root {
  /* --- paleta original do Semeia: continua sendo a identidade --- */
  --papel: #fdfbf7;
  --pinho: #2b4739;
  --musgo: #5e7a63;
  --trigo: #c89b3c;
  --barro: #9c4a3c;
  --linha: #e2dcd0;

  /* --- ceu: do azul alto ate o calor do horizonte --- */
  --ceu-alto: #7fb2d9;
  --ceu-meio: #a9cfe8;
  --ceu-baixo: #d9e9f2;
  --horizonte: #fbead1;

  /* --- vidro --- */
  --vidro: rgba(255, 253, 248, 0.72);
  --vidro-forte: rgba(255, 253, 248, 0.86);
  --vidro-borda: rgba(255, 255, 255, 0.75);
  --vidro-sombra: 0 10px 30px -12px rgba(30, 60, 85, 0.28);

  --serif: "Newsreader", Georgia, serif;
  --titulo: "Fraunces", "Newsreader", Georgia, serif;
  --sans: "Karla", system-ui, -apple-system, sans-serif;

  /* escala fluida: um so valor serve do celular ao desktop */
  --t-versiculo: clamp(1.5rem, 1.15rem + 1.7vw, 2.25rem);
  --t-h1: clamp(1.75rem, 1.4rem + 1.6vw, 2.5rem);
  --t-h2: clamp(1.2rem, 1.08rem + 0.55vw, 1.5rem);
  --t-corpo: clamp(1rem, 0.97rem + 0.15vw, 1.075rem);
}

* { box-sizing: border-box; }

html { -webkit-text-size-adjust: 100%; }

html, body {
  margin: 0;
  padding: 0;
  min-height: 100%;
  color: var(--pinho);
  font-family: var(--sans);
  font-size: var(--t-corpo);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

/* O ceu fica preso na viewport: rola o conteudo, nao o fundo. */
body {
  background:
    linear-gradient(
      to bottom,
      var(--ceu-alto) 0%,
      var(--ceu-meio) 38%,
      var(--ceu-baixo) 72%,
      var(--horizonte) 100%
    )
    fixed;
}

/* ---------------------------------------------------------------
   Nuvens: desenhadas em CSS, sem imagem nem biblioteca.
   Ficam atras de tudo e nao capturam clique.
   --------------------------------------------------------------- */
.ceu {
  position: fixed;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
  z-index: 0;
}

.nuvem {
  position: absolute;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 100px;
  filter: blur(0.3px);
  opacity: 0.9;
  will-change: transform;
}

/* os dois bojos que transformam a capsula em nuvem */
.nuvem::before,
.nuvem::after {
  content: "";
  position: absolute;
  background: inherit;
  border-radius: 50%;
}
.nuvem::before {
  width: 55%;
  height: 150%;
  top: -60%;
  left: 12%;
}
.nuvem::after {
  width: 38%;
  height: 115%;
  top: -42%;
  right: 14%;
}

.nuvem-1 { width: 170px; height: 52px; top: 8%;  left: -30%; animation: navegar 78s linear infinite; }
.nuvem-2 { width: 110px; height: 36px; top: 24%; left: -30%; opacity: 0.7; animation: navegar 112s linear infinite 9s; }
.nuvem-3 { width: 230px; height: 66px; top: 46%; left: -40%; opacity: 0.55; animation: navegar 145s linear infinite 4s; }
.nuvem-4 { width: 140px; height: 44px; top: 66%; left: -30%; opacity: 0.45; animation: navegar 96s linear infinite 22s; }

@keyframes navegar {
  from { transform: translateX(0); }
  to   { transform: translateX(180vw); }
}

/* ---------------------------------------------------------------
   Estrutura: laterais no desktop, coluna unica no celular
   --------------------------------------------------------------- */
.app {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: minmax(0, 1fr);
}

/* As laterais so existem quando ha espaco de verdade para elas. */
.lateral { display: none; }

@media (min-width: 62rem) {
  .app {
    grid-template-columns: 13.5rem minmax(0, 34rem) 14rem;
    justify-content: center;
    align-items: start;
    gap: 1.25rem;
    padding: 2.5rem 1.5rem 4rem;
  }
  .lateral {
    display: block;
    position: sticky;
    top: 2.5rem;
  }
}

/* Lateral esquerda: marca + menu */
.marca {
  display: block;
  text-decoration: none;
  color: var(--pinho);
  margin-bottom: 1.5rem;
  padding: 0 0.6rem;
}
.marca-conteudo { display: flex; align-items: center; gap: 0.6rem; }

/* A pomba e branca, entao so aparece sobre fundo escuro. O selo e o fundo. */
.selo-pomba {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: none;
  background: var(--pinho);
  border-radius: 28%;
  box-shadow: 0 4px 12px -6px rgba(43, 71, 57, 0.8);
  /* Sem padding em %: porcentagem de padding resolve contra a largura do
     PAI, nao deste elemento. Num selo de 38px dentro de uma lateral de
     216px, 14% virava ~30px de cada lado, a area de conteudo ia a zero e a
     pomba sumia. O respiro agora vem do tamanho da propria imagem. */
}
.selo-pomba img {
  width: 74%;
  height: 74%;
  object-fit: contain;
  display: block;
}

/* Opcao 1 do logo: pomba solta, sem o selo verde atras. */
.selo-nu { background: none; box-shadow: none; }
.selo-nu img { width: 100%; height: 100%; }
.marca-nome {
  font-family: var(--titulo);
  font-size: 1.35rem;
  font-weight: 600;
  letter-spacing: -0.02em;
}

.menu { display: flex; flex-direction: column; gap: 0.2rem; }
.menu-item {
  display: flex;
  align-items: center;
  gap: 0.7rem;
  padding: 0.65rem 0.8rem;
  border-radius: 12px;
  text-decoration: none;
  color: var(--pinho);
  font: 600 0.95rem var(--sans);
  transition: background 0.14s ease, transform 0.14s ease;
}
.menu-item:hover { background: rgba(255, 255, 255, 0.6); transform: translateX(2px); }
.menu-item[aria-current="page"] {
  background: var(--pinho);
  color: var(--papel);
}
.menu-icone { font-size: 1rem; width: 1.1rem; text-align: center; opacity: 0.85; }

/* Lateral direita: atalhos */
.cartao-lateral {
  background: rgba(255, 255, 255, 0.55);
  border: 1px solid var(--vidro-borda);
  border-radius: 16px;
  padding: 1rem;
  margin-bottom: 0.85rem;
}
.cartao-titulo {
  font-family: var(--titulo);
  font-size: 0.98rem;
  font-weight: 600;
  margin: 0 0 0.35rem;
}
.cartao-texto {
  font-size: 0.82rem;
  line-height: 1.5;
  color: var(--musgo);
  margin: 0 0 0.75rem;
  max-width: none;
}
.botao-pequeno { padding: 0.55rem 0.8rem; font-size: 0.85rem; border-radius: 10px; }

.lateral-rodape {
  font-size: 0.72rem;
  line-height: 1.55;
  color: var(--musgo);
  padding: 0.4rem;
  max-width: none;
}
/* Sem isto o nome do autor quebra no meio e o credito vira tres linhas
   tortas: o link e curto e deve ficar sempre inteiro. */
.lateral-rodape a {
  color: var(--musgo);
  white-space: nowrap;
}

/* ---------------------------------------------------------------
   Barra fixa do celular
   --------------------------------------------------------------- */
.barra-inferior {
  position: fixed;
  z-index: 20;
  left: 0;
  right: 0;
  bottom: 0;
  display: grid;
  /* Um destino por coluna. Mudou a lista em Navegacao.tsx? Mude aqui. */
  grid-template-columns: repeat(6, 1fr);
  background: var(--vidro-forte);
  -webkit-backdrop-filter: blur(16px);
  backdrop-filter: blur(16px);
  border-top: 1px solid var(--vidro-borda);
  /* respeita a faixa do gesto de home no iPhone */
  padding-bottom: env(safe-area-inset-bottom, 0);
}

.barra-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.15rem;
  padding: 0.55rem 0.1rem 0.6rem;
  text-decoration: none;
  color: var(--musgo);
  /* Com 6 colunas num celular de 360px sobram 60px por item: o rotulo
     precisa caber sem quebrar no meio da palavra. */
  font-size: 0.62rem;
  font-weight: 600;
  text-align: center;
  transition: color 0.14s ease;
}
.barra-rotulo { white-space: nowrap; }
.barra-item[aria-current="page"] { color: var(--pinho); }
.barra-icone { font-size: 1.15rem; line-height: 1; }
.barra-item[aria-current="page"] .barra-icone { transform: scale(1.1); }

@media (min-width: 62rem) {
  .barra-inferior { display: none; }
}

/* ---------------------------------------------------------------
   A folha: cartao de vidro sobre o ceu
   --------------------------------------------------------------- */
.folha {
  position: relative;
  z-index: 1;
  max-width: 34rem;
  margin: 0 auto;
  min-height: 100dvh;
  /* O 6rem no fim e o espaco da barra fixa do celular: sem ele, a barra
     cobre a ultima linha de texto. O abreviado tem que vir antes de
     qualquer padding-bottom, senao apaga o valor. */
  padding: clamp(1.25rem, 4vw, 2.5rem) clamp(1.1rem, 4vw, 2rem) 6rem;

  background: var(--vidro);
  -webkit-backdrop-filter: blur(14px) saturate(1.15);
  backdrop-filter: blur(14px) saturate(1.15);
  border-left: 1px solid var(--vidro-borda);
  border-right: 1px solid var(--vidro-borda);
  box-shadow: var(--vidro-sombra);
}

/* A partir de tablet a folha descola do topo e vira cartao flutuante. */
@media (min-width: 40rem) {
  .folha {
    min-height: auto;
    margin: 2.5rem auto 4rem;
    border-radius: 20px;
    border: 1px solid var(--vidro-borda);
    padding-bottom: 4rem;
  }
}

/* Com as laterais no ar, quem cuida do respiro em volta e o .app.
   A folha zera a margem propria para nao somar duas vezes. */
@media (min-width: 62rem) {
  .folha { margin: 0; }
}

/* Navegador sem backdrop-filter (Firefox antigo) recebe fundo solido,
   senao o texto fica ilegivel sobre o gradiente. */
@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
  .folha { background: var(--vidro-forte); }
}

/* ---------- versiculo: continua sendo o heroi da tela ---------- */
.versiculo {
  font-family: var(--serif);
  font-size: var(--t-versiculo);
  font-weight: 400;
  line-height: 1.42;
  margin: 0 0 0.75rem;
  text-wrap: balance;
  letter-spacing: -0.011em;
}

.referencia {
  font-family: var(--sans);
  font-size: 0.82rem;
  font-weight: 500;
  letter-spacing: 0.045em;
  text-transform: uppercase;
  color: var(--musgo);
}

h1 {
  font-family: var(--titulo);
  font-size: var(--t-h1);
  font-weight: 600;
  line-height: 1.12;
  letter-spacing: -0.018em;
  margin: 0 0 0.6rem;
  text-wrap: balance;
}

h2 {
  font-family: var(--titulo);
  font-size: var(--t-h2);
  font-weight: 600;
  letter-spacing: -0.012em;
  margin: 2.25rem 0 0.75rem;
}

p { line-height: 1.68; max-width: 62ch; }

/* ---------------------------------------------------------------
   Botoes
   --------------------------------------------------------------- */
.botao {
  display: inline-block;
  width: 100%;
  padding: 0.95rem 1.15rem;
  border: 0;
  border-radius: 14px;
  background: linear-gradient(180deg, #35573f 0%, var(--pinho) 100%);
  color: var(--papel);
  font: 600 1.02rem var(--sans);
  letter-spacing: 0.01em;
  text-align: center;
  text-decoration: none;
  cursor: pointer;
  box-shadow: 0 6px 16px -8px rgba(43, 71, 57, 0.7);
  transition: transform 0.16s ease, box-shadow 0.16s ease, filter 0.16s ease;
}
.botao:hover:not(:disabled) {
  transform: translateY(-2px);
  box-shadow: 0 12px 22px -10px rgba(43, 71, 57, 0.75);
  filter: brightness(1.07);
}
.botao:active:not(:disabled) {
  transform: translateY(0);
  box-shadow: 0 4px 10px -6px rgba(43, 71, 57, 0.7);
}
.botao:disabled { opacity: 0.45; cursor: default; box-shadow: none; }

.botao-vazado {
  background: rgba(255, 255, 255, 0.55);
  color: var(--pinho);
  border: 1px solid var(--vidro-borda);
  box-shadow: none;
}
.botao-vazado:hover:not(:disabled) {
  background: rgba(255, 255, 255, 0.8);
  filter: none;
}

input[type="text"] {
  width: 100%;
  padding: 0.9rem 1rem;
  border: 1px solid var(--vidro-borda);
  border-radius: 12px;
  font: 400 1.02rem var(--sans);
  background: rgba(255, 255, 255, 0.72);
  color: var(--pinho);
  transition: border-color 0.16s ease, background 0.16s ease;
}
input[type="text"]:focus { background: #fff; }

:focus-visible { outline: 2px solid var(--pinho); outline-offset: 3px; }

/* ---------------------------------------------------------------
   Barra de progresso da rodada
   --------------------------------------------------------------- */
.progresso {
  height: 6px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.55);
  overflow: hidden;
}
.progresso-barra {
  height: 100%;
  border-radius: 999px;
  background: linear-gradient(90deg, var(--musgo), var(--pinho));
  transition: width 0.35s cubic-bezier(0.22, 1, 0.36, 1);
}

/* ---------------------------------------------------------------
   Alternativas do quiz
   --------------------------------------------------------------- */
.alternativa {
  display: block;
  width: 100%;
  text-align: left;
  padding: 0.95rem 1.1rem;
  margin-bottom: 0.65rem;
  border: 1px solid var(--vidro-borda);
  border-left: 4px solid rgba(255, 255, 255, 0.9);
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.6);
  color: var(--pinho);
  font: 500 1.02rem/1.45 var(--sans);
  cursor: pointer;
  transition: transform 0.14s ease, background 0.14s ease, border-color 0.14s ease;
}
.alternativa:hover:not(:disabled) {
  background: rgba(255, 255, 255, 0.88);
  border-left-color: var(--musgo);
  transform: translateX(3px);
}
.alternativa:disabled { cursor: default; }

.alternativa.certa {
  border-left-color: var(--musgo);
  background: rgba(226, 240, 228, 0.92);
  animation: acertou 0.45s ease;
}
.alternativa.errada {
  border-left-color: var(--barro);
  background: rgba(248, 235, 232, 0.92);
}

/* Confirmacao discreta: cresce e volta. Sem som, sem tremor de reprovacao. */
@keyframes acertou {
  0%   { transform: scale(1); }
  45%  { transform: scale(1.022); }
  100% { transform: scale(1); }
}

.explicacao {
  border-left: 3px solid var(--trigo);
  background: rgba(255, 255, 255, 0.5);
  border-radius: 0 12px 12px 0;
  padding: 0.85rem 1rem;
  margin: 1.35rem 0;
  animation: surgir 0.35s ease both;
}
.explicacao p { margin: 0 0 0.5rem; }
.explicacao p:last-child { margin-bottom: 0; }

@keyframes surgir {
  from { opacity: 0; transform: translateY(8px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ---------------------------------------------------------------
   Podio: os tres primeiros
   --------------------------------------------------------------- */
/* Flex, e nao grid de 3 colunas, para que um podio com uma ou duas pessoas
   fique centralizado em vez de encostar na esquerda com buracos ao lado. */
.podio {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 0.6rem;
  list-style: none;
  margin: 1.5rem 0 1.75rem;
  padding: 0;
}

.podio-lugar {
  flex: 1 1 0;
  min-width: 0;
  max-width: 11rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 0.9rem 0.4rem 1rem;
  border-radius: 16px 16px 10px 10px;
  background: rgba(255, 255, 255, 0.62);
  border: 1px solid var(--vidro-borda);
  box-shadow: 0 8px 20px -14px rgba(30, 60, 85, 0.5);
  animation: subir 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
}

/* a ordem visual poe o 1o no meio, como num podio de verdade */
.podio-1 { order: 2; padding-top: 1.4rem; padding-bottom: 1.5rem; animation-delay: 0.06s; }
.podio-2 { order: 1; animation-delay: 0.16s; }
.podio-3 { order: 3; animation-delay: 0.26s; }

.podio-1 {
  background: linear-gradient(180deg, rgba(255, 248, 232, 0.95) 0%, rgba(250, 238, 212, 0.8) 100%);
  border-color: rgba(200, 155, 60, 0.5);
  box-shadow: 0 12px 26px -14px rgba(160, 120, 40, 0.7);
}

@keyframes subir {
  from { opacity: 0; transform: translateY(16px); }
  to   { opacity: 1; transform: translateY(0); }
}

.podio-medalha { font-size: 1.5rem; line-height: 1; margin-bottom: 0.35rem; }
.podio-1 .podio-medalha { font-size: 1.9rem; }

.podio-apelido {
  font-family: var(--titulo);
  font-weight: 600;
  font-size: 0.95rem;
  line-height: 1.2;
  overflow-wrap: anywhere;
  margin-bottom: 0.15rem;
}
.podio-1 .podio-apelido { font-size: 1.08rem; }

.podio-pontos {
  font-family: var(--serif);
  font-size: 1.45rem;
  font-weight: 600;
  color: var(--pinho);
  line-height: 1.1;
}
.podio-1 .podio-pontos { font-size: 1.8rem; color: #8a6620; }

.podio-detalhe { font-size: 0.7rem; color: var(--musgo); margin-top: 0.1rem; }

.podio-lugar.eu {
  outline: 2px solid var(--pinho);
  outline-offset: 2px;
}

/* ---------------------------------------------------------------
   Restante do ranking (4o em diante)
   --------------------------------------------------------------- */
.rank { list-style: none; margin: 0; padding: 0; }
.rank li {
  display: grid;
  grid-template-columns: 2.2rem 1fr auto;
  align-items: center;
  gap: 0.75rem;
  padding: 0.75rem 0.7rem;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.4);
  border: 1px solid transparent;
  margin-bottom: 0.4rem;
  transition: background 0.14s ease;
}
.rank li:hover { background: rgba(255, 255, 255, 0.65); }
.rank .posicao { font-family: var(--serif); font-size: 1.05rem; color: var(--musgo); }
.rank .apelido { font-weight: 600; overflow-wrap: anywhere; }
.rank .detalhe { display: block; font-size: 0.75rem; color: var(--musgo); font-weight: 400; }
.rank .pontos { font-family: var(--serif); font-size: 1.2rem; font-weight: 600; }
.rank li.eu {
  background: rgba(255, 248, 232, 0.85);
  border-color: rgba(200, 155, 60, 0.45);
}

/* ---------------------------------------------------------------
   Barra de voltar / cancelar
   --------------------------------------------------------------- */
.voltar-barra {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 0.5rem;
  flex-wrap: wrap;
  margin-bottom: 1.25rem;
}

.voltar {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.45rem 0.95rem 0.45rem 0.75rem;
  border-radius: 999px;
  border: 1px solid var(--vidro-borda);
  background: rgba(255, 255, 255, 0.5);
  color: var(--pinho);
  font: 600 0.88rem var(--sans);
  text-decoration: none;
  cursor: pointer;
  transition: background 0.14s ease, transform 0.14s ease;
}
.voltar:hover {
  background: rgba(255, 255, 255, 0.85);
  transform: translateX(-2px);
}
.voltar span { font-size: 1.05em; line-height: 1; }

/* variante para "cancelar" / "sair", que aponta para saida e nao para tras */
.voltar-discreto {
  border-color: transparent;
  background: transparent;
  color: var(--musgo);
  font-weight: 500;
}
.voltar-discreto:hover {
  background: rgba(255, 255, 255, 0.6);
  transform: none;
}

/* ---------------------------------------------------------------
   Pedidos de oracao
   --------------------------------------------------------------- */
.caixa-pedido {
  margin: 1.5rem 0 0.5rem;
  padding: 1.1rem;
  border-radius: 16px;
  border: 1px solid var(--vidro-borda);
  background: rgba(255, 255, 255, 0.55);
}

textarea {
  width: 100%;
  margin-top: 0.5rem;
  padding: 0.85rem 1rem;
  border: 1px solid var(--vidro-borda);
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.8);
  color: var(--pinho);
  font: 400 1.02rem/1.55 var(--sans);
  resize: vertical;
  min-height: 5.5rem;
}
textarea:focus { background: #fff; }

.pedido-rodape {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 0.75rem;
  flex-wrap: wrap;
  margin: 0.7rem 0 0.9rem;
}
.pedido-anonimo {
  display: flex;
  align-items: center;
  gap: 0.45rem;
  font-size: 0.86rem;
  cursor: pointer;
}

.pedidos { list-style: none; margin: 2rem 0 0; padding: 0; }
.pedidos li {
  padding: 1.1rem 1.15rem;
  margin-bottom: 0.8rem;
  border-radius: 16px;
  border: 1px solid var(--vidro-borda);
  border-left: 4px solid var(--trigo);
  background: rgba(255, 255, 255, 0.55);
}

.pedido-texto {
  font-family: var(--serif);
  font-size: 1.1rem;
  line-height: 1.5;
  margin: 0 0 0.55rem;
  overflow-wrap: anywhere;
  white-space: pre-wrap;
}
.pedido-quem {
  margin: 0 0 0.85rem;
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--musgo);
}
.pedido-acoes { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }

.orei {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.55rem 1rem;
  border-radius: 999px;
  border: 1px solid var(--pinho);
  background: transparent;
  color: var(--pinho);
  font: 600 0.88rem var(--sans);
  cursor: pointer;
  transition: background 0.14s ease, color 0.14s ease, transform 0.14s ease;
}
.orei:hover:not(:disabled) { background: var(--pinho); color: var(--papel); transform: translateY(-1px); }
.orei-feito {
  background: rgba(94, 122, 99, 0.16);
  border-color: transparent;
  color: var(--musgo);
  cursor: default;
}
.orei-conta {
  min-width: 1.4rem;
  padding: 0 0.35rem;
  border-radius: 999px;
  background: rgba(43, 71, 57, 0.12);
  font-size: 0.8rem;
  text-align: center;
}
.orei-feito .orei-conta { background: rgba(94, 122, 99, 0.22); }

/* ---------------------------------------------------------------
   Mundo gospel
   --------------------------------------------------------------- */
.noticias { list-style: none; margin: 1.5rem 0 0; padding: 0; }
.noticias li { margin-bottom: 0.8rem; }

.noticias a {
  display: block;
  border-radius: 16px;
  border: 1px solid var(--vidro-borda);
  background: rgba(255, 255, 255, 0.6);
  text-decoration: none;
  color: var(--pinho);
  overflow: hidden;
  transition: background 0.16s ease, transform 0.16s ease, box-shadow 0.16s ease;
}
.noticias a:hover {
  background: rgba(255, 255, 255, 0.92);
  transform: translateY(-2px);
  box-shadow: 0 12px 26px -16px rgba(30, 60, 85, 0.7);
}

.noticia-corpo { display: block; padding: 1rem 1.15rem 1.1rem; }

/* Fonte maior só aqui: manchete precisa de peso, e esta pagina é de leitura
   rápida, não de meditação como o versículo da home. */
.noticia-titulo {
  display: block;
  font-family: var(--titulo);
  font-weight: 600;
  font-size: 1.18rem;
  line-height: 1.28;
  letter-spacing: -0.015em;
  text-wrap: balance;
}
.noticia-resumo {
  display: -webkit-box;
  margin-top: 0.5rem;
  font-size: 1rem;
  line-height: 1.55;
  color: #3c5348;
  -webkit-line-clamp: 3;
  line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.noticia-fonte {
  display: block;
  margin-top: 0.7rem;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--musgo);
}

/* ---- as tres em destaque, com capa ---- */
.noticia-capa {
  display: block;
  aspect-ratio: 16 / 9;
  background: rgba(43, 71, 57, 0.08);
}
.noticia-capa img {
  width: 100%;
  height: 100%;
  max-width: 100%;
  object-fit: cover;
  display: block;
}

.noticias-destaque .noticia-titulo { font-size: 1.42rem; line-height: 1.22; }
.noticias-destaque .noticia-resumo { font-size: 1.03rem; -webkit-line-clamp: 4; line-clamp: 4; }
.noticias-destaque li { margin-bottom: 1.1rem; }

/* ---- as demais: miniatura ao lado do texto ---- */
.noticias:not(.noticias-destaque) a {
  display: grid;
  grid-template-columns: 1fr 6.5rem;
  align-items: stretch;
  gap: 0;
}
.noticia-miniatura { display: block; }
.noticia-miniatura img {
  width: 100%;
  height: 100%;
  max-width: 100%;
  object-fit: cover;
  display: block;
}

@media (max-width: 26rem) {
  /* No celular estreito a miniatura come o titulo: some com ela. */
  .noticias:not(.noticias-destaque) a { grid-template-columns: 1fr; }
  .noticia-miniatura { display: none; }
}

/* ---------------------------------------------------------------
   Abas
   --------------------------------------------------------------- */
.abas { display: flex; gap: 0.5rem; margin-bottom: 1rem; flex-wrap: wrap; }
.abas a {
  padding: 0.5rem 1rem;
  border-radius: 999px;
  border: 1px solid var(--vidro-borda);
  background: rgba(255, 255, 255, 0.45);
  text-decoration: none;
  color: var(--musgo);
  font-size: 0.9rem;
  font-weight: 600;
  transition: background 0.14s ease, color 0.14s ease;
}
.abas a:hover { background: rgba(255, 255, 255, 0.8); }
.abas a[aria-current="page"] {
  background: var(--pinho);
  border-color: var(--pinho);
  color: var(--papel);
}

.rodape {
  margin-top: 3rem;
  font-size: 0.78rem;
  line-height: 1.6;
  color: var(--musgo);
}
.rodape a { color: var(--musgo); }

/* ---------------------------------------------------------------
   Quem pediu menos movimento recebe menos movimento.
   --------------------------------------------------------------- */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.001ms !important;
  }
  .nuvem { display: none; }
}
